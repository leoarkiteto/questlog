# Questlog backend — copy this file to .env and fill in your values.
#   cp .env.example .env
# Secrets in .env are gitignored; existing shell env vars take
# precedence over this file.

# Postgres connection (default matches docker-compose.yml)
# DATABASE_URL=postgres://gamelog@localhost:5432/gamelog
# PORT=8080

# Steam Web API key — kept server-side (optional for current features)
# STEAM_API_KEY=

# IGDB via a free Twitch developer app (dev.twitch.tv/console/apps).
# Required for covers of games that are not on Steam (PS5, Switch, …).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Build stage
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/questlog .

# Runtime stage — Vercel container services expect an HTTP server
# (default port 80, overridable via the PORT env var).
FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 app
COPY --from=build /out/questlog /usr/local/bin/questlog
USER app
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/questlog"]
